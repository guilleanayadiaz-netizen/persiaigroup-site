<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PERSIAI GROUP, LLC</title>
    <style>
        :root {
            --bg-color: #000000;
            --container-bg: rgba(10, 10, 10, 0.85);
            --text-color: #e5e5e5;
            --accent-gold: #d4af37;
            --deep-gold: #aa841c;
            --muted-color: #a3a3a3;
            --border-color: #1a1a1a;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: var(--bg-color);
            /* Mathematical Quantum Superposition Graph Grid Background */
            background-image: 
                linear-gradient(to right, rgba(212, 175, 55, 0.03) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(212, 175, 55, 0.03) 1px, transparent 1px),
                radial-gradient(ellipse at 50% 30%, rgba(170, 132, 28, 0.15), transparent 60%),
                linear-gradient(135deg, transparent 45%, rgba(212, 175, 55, 0.05) 49%, rgba(212, 175, 55, 0.08) 50%, rgba(212, 175, 55, 0.05) 51%, transparent 55%);
            background-size: 40px 40px, 40px 40px, 100% 100%, 100% 100%;
            color: var(--text-color);
            line-height: 1.6;
            padding: 40px 20px;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        /* Abstract overlapping sine waves to mimic a superposition state graph */
        body::before {
            content: "";
            position: absolute;
            top: 15%;
            left: 0;
            width: 100%;
            height: 300px;
            background: 
                radial-gradient(circle at 30% 50%, transparent 60%, rgba(212, 175, 55, 0.02) 62%, transparent 65%),
                radial-gradient(circle at 70% 30%, transparent 50%, rgba(212, 175, 55, 0.02) 52%, transparent 55%);
            pointer-events: none;
            z-index: 0;
        }

        .container {
            max-width: 650px;
            width: 100%;
            background: var(--container-bg);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            padding: 40px;
            border-radius: 8px;
            border: 1px solid var(--border-color);
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.9);
            position: relative;
            overflow: hidden;
            z-index: 1;
        }

        /* Tactical mathematical coordinate alignment bar */
        .container::before {
            content: "";
            position: absolute;
            top: 0;
            right: 0;
            width: 100%;
            height: 3px;
            background: linear-gradient(90deg, transparent, var(--accent-gold), transparent);
        }

        header {
            margin-bottom: 32px;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 24px;
        }

        h1 {
            font-size: 1.75rem;
            font-weight: 700;
            letter-spacing: 0.05em;
            color: #ffffff;
            margin-bottom: 4px;
        }

        .subtitle {
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            color: var(--accent-gold);
            font-weight: 600;
            margin-bottom: 16px;
        }

        .executive-contact {
            font-size: 0.85rem;
            color: var(--muted-color);
            border-left: 2px solid var(--accent-gold);
            padding-left: 12px;
            margin-top: 12px;
        }

        .executive-name {
            color: #ffffff;
            font-weight: 500;
            letter-spacing: 0.02em;
        }

        main {
            margin-bottom: 32px;
        }

        section {
            margin-bottom: 32px;
        }

        section h2 {
            font-size: 1rem;
            font-weight: 600;
            color: #ffffff;
            margin-bottom: 16px;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 6px;
        }

        .about-text {
            font-size: 0.95rem;
            color: #cccccc;
            text-align: justify;
        }

        .cap-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 12px;
        }

        .cap-card {
            background: rgba(15, 15, 15, 0.9);
            padding: 18px;
            border-radius: 4px;
            border: 1px solid var(--border-color);
            transition: all 0.2s ease;
        }

        .cap-card:hover {
            border-color: var(--deep-gold);
            background: rgba(20, 20, 20, 0.95);
        }

        .cap-card h3 {
            font-size: 0.95rem;
            color: var(--accent-gold);
            margin-bottom: 6px;
            font-weight: 600;
            letter-spacing: 0.02em;
        }

        .cap-card p {
            font-size: 0.9rem;
            color: var(--muted-color);
        }

        .cta-container {
            display: flex;
            flex-direction: column;
            gap: 16px;
            align-items: center;
            margin-top: 36px;
        }

        .btn {
            display: inline-block;
            width: 100%;
            max-width: 380px;
            text-align: center;
            font-weight: 600;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            text-decoration: none;
            padding: 14px 24px;
            border-radius: 4px;
            transition: all 0.2s ease;
        }

        .btn-primary {
            background-color: transparent;
            color: var(--accent-gold);
            border: 1px solid var(--accent-gold);
        }

        .btn-primary:hover {
            background-color: var(--accent-gold);
            color: #000000;
            box-shadow: 0 0 15px rgba(212, 175, 55, 0.3);
        }

        .btn-secondary {
            background-color: rgba(15, 15, 15, 0.8);
            color: #ffffff;
            border: 1px solid var(--border-color);
            font-size: 0.8rem;
        }

        .btn-secondary:hover {
            border-color: var(--muted-color);
            background-color: #1a1a1a;
        }

        footer {
            border-top: 1px solid var(--border-color);
            padding-top: 20px;
            text-align: center;
            font-size: 0.75rem;
            color: var(--muted-color);
            letter-spacing: 0.05em;
        }
    </style>
</head>
