    <style>
        :root {
            --bg-color: #000000;
            --container-bg: rgba(10, 10, 10, 0.9);
            --text-color: #e5e5e5;
            --accent-gold: #d4af37;
            --deep-gold: #aa841c;
            --muted-color: #a3a3a3;
            --border-color: #1a1a1a;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: var(--bg-color);
            background-image: 
                radial-gradient(rgba(212, 175, 55, 0.015) 1px, transparent 0),
                radial-gradient(ellipse at 50% 20%, rgba(170, 132, 28, 0.1), transparent 50%);
            background-size: 30px 30px, 100% 100%;
            color: var(--text-color);
            line-height: 1.6;
            padding: 40px 20px;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        .container {
            max-width: 650px;
            width: 100%;
            background: var(--container-bg);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            padding: 40px;
            border-radius: 8px;
            border: 1px solid var(--border-color);
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.95);
            position: relative;
            overflow: hidden;
        }

        .container::before {
            content: "";
            position: absolute;
            top: 0;
            right: 0;
            width: 100%;
            height: 3px;
            background: linear-gradient(90deg, transparent, var(--accent-gold), transparent);
        }

        header {
            margin-bottom: 32px;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 24px;
            text-align: center;
        }

        /* Pure CSS Vector Logo: 4th Concept (Lorenz Chaotic Attractor Loops) */
        .logo-mark {
            width: 90px;
            height: 55px;
            margin: 0 auto 20px auto;
            position: relative;
            opacity: 0.95;
        }

        .logo-mark::before {
            content: "";
            position: absolute;
            width: 42px;
            height: 48px;
            right: 2px;
            top: 2px;
            border: 2px solid var(--accent-gold);
            border-radius: 65% 35% 45% 55% / 40% 60% 40% 60%;
            transform: rotate(25deg);
            border-left: 1px solid transparent;
            border-bottom: 1px solid transparent;
        }

        .logo-mark::after {
            content: "";
            position: absolute;
            width: 42px;
            height: 48px;
            left: 2px;
            top: 2px;
            border: 2px solid #ffffff;
            border-radius: 35% 65% 55% 45% / 60% 40% 60% 40%;
            transform: rotate(-25deg);
            border-right: 1px solid transparent;
            border-bottom: 1px solid transparent;
            opacity: 0.8;
        }

        h1 {
            font-size: 1.75rem;
            font-weight: 700;
            letter-spacing: 0.05em;
            color: #ffffff;
            margin-bottom: 4px;
        }

        .subtitle {
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            color: var(--accent-gold);
            font-weight: 600;
            margin-bottom: 16px;
        }

        .executive-contact {
            font-size: 0.85rem;
            color: var(--muted-color);
            border-left: 2px solid var(--accent-gold);
            padding-left: 12px;
            margin: 16px auto 0 auto;
            display: inline-block;
            text-align: left;
        }

        .executive-name {
            color: #ffffff;
            font-weight: 500;
            letter-spacing: 0.02em;
        }

        main {
            margin-bottom: 32px;
        }

        section {
            margin-bottom: 32px;
        }

        section h2 {
            font-size: 1rem;
            font-weight: 600;
            color: #ffffff;
            margin-bottom: 16px;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 6px;
        }

        /* Target Paragraph: Single-Spaced Focus Executive Copy */
        .about-text {
            font-size: 0.95rem;
            color: #cccccc;
            text-align: justify;
            line-height: 1.3;
        }

        .cap-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 12px;
        }

        .cap-card {
            background: #0a0a0a;
            padding: 18px;
            border-radius: 4px;
            border: 1px solid var(--border-color);
            transition: border-color 0.2s ease;
        }

        .cap-card:hover {
            border-color: var(--deep-gold);
        }

        .cap-card h3 {
            font-size: 0.95rem;
            color: var(--accent-gold);
            margin-bottom: 6px;
            font-weight: 600;
            letter-spacing: 0.02em;
        }

        .cap-card p {
            font-size: 0.9rem;
            color: var(--muted-color);
            line-height: 1.35;
        }

        .cta-container {
            display: flex;
            flex-direction: column;
            gap: 16px;
            align-items: center;
            margin-top: 36px;
        }

        .btn {
            display: inline-block;
            width: 100%;
            max-width: 380px;
            text-align: center;
            font-weight: 600;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            text-decoration: none;
            padding: 14px 24px;
            border-radius: 4px;
            transition: all 0.2s ease;
        }

        .btn-primary {
            background-color: transparent;
            color: var(--accent-gold);
            border: 1px solid var(--accent-gold);
        }

        .btn-primary:hover {
            background-color: var(--accent-gold);
            color: #000000;
            box-shadow: 0 0 15px rgba(212, 175, 55, 0.3);
        }

        .btn-secondary {
            background-color: #0f0f0f;
            color: #ffffff;
            border: 1px solid var(--border-color);
            font-size: 0.8rem;
        }

        .btn-secondary:hover {
            border-color: var(--muted-color);
            background-color: #1a1a1a;
        }

        footer {
            border-top: 1px solid var(--border-color);
            padding-top: 20px;
            text-align: center;
            font-size: 0.75rem;
            color: var(--muted-color);
            letter-spacing: 0.05em;
        }

        /* 📱 UNIVERSAL SMARTPHONE RESPONSIVE OVERRIDES */
        @media (max-width: 480px) {
            body {
                padding: 15px 10px;
            }
            .container {
                padding: 24px 16px;
            }
            h1 {
                font-size: 1.4rem;
                line-height: 1.2;
            }
            .subtitle {
                font-size: 0.75rem;
                letter-spacing: 0.1em;
            }
            .about-text {
                font-size: 0.9rem;
